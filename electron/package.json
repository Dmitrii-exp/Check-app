{
  "name": "check-app-windows",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ru.appcheck.desktop",
    "productName": "Check App",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "offline.html",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "createDesktopShortcut": true,
      "artifactName": "Check-App-Setup-${version}.${ext}"
    }
  }
}