{
  "name": "check-app",
  "version": "1.2.13",
  "private": true,
  "description": "Check App — система контроля технического обслуживания",
  "scripts": {
    "dev": "npx serve .",
    "preview": "npx serve .",
    "build:css": "tailwindcss -i ./css/tailwind.input.css -o ./css/tailwind.css --minify",
    "prepare:production": "node scripts/prepare-production.mjs",
    "cap:sync": "npx cap sync",
    "android": "npx cap open android",
    "ios": "npx cap open ios",
    "build:mobile": "npm run build:css && node scripts/build-mobile.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/share": "8.0.3",
    "@supabase/supabase-js": "2.114.0",
    "exceljs": "4.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "tailwindcss": "^3.4.17"
  }
}
